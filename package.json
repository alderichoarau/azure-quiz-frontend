{
  "name": "azure-quiz-frontend",
  "version": "1.6.0",
  "license": "UNLICENSED",
  "author": "Alderic Hoarau",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --coverage --watch=false",
    "lint": "ng lint --max-warnings=0",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,js,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,html,scss,css,json}\"",
    "check": "npm run lint && npm run format:check",
    "prepare": "husky",
    "postinstall": "node scripts/generate-version.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "prettier --write"
    ],
    "src/**/*.{html,scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/animations": "22.1.4",
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/material": "22.1.4",
    "@angular/router": "22.1.4",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.1.0",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
